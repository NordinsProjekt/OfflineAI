{
  "Security": {
    "RequireApiKey": true,
    "ApiKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET (callers must send it as the X-API-Key header; set RequireApiKey to false only for trusted localhost-only use)",
    "AllowedCorsOrigins": [ "https://localhost:7015", "http://localhost:5118" ],
    "MaxConcurrentRequests": 0
  },
  "AppConfiguration": {
    "Llm": {
      "ExecutablePath": "REPLACE_WITH_PATH_TO_llama-cli.exe",
      "ModelPath": "REPLACE_WITH_PATH_TO_model.gguf",
      "ModelName": "mistral-7b-instruct-v0.2.q5_k_m",
      "ModelType": "Mistral",
      "UseGpu": false,
      "GpuLayers": 0,
      "ContextSize": 2048
    },
    "Embedding": {
      "ModelPath": "REPLACE_WITH_PATH_TO_embedding_model.onnx (optional, enables auto vector search RAG)",
      "VocabPath": "REPLACE_WITH_PATH_TO_vocab.txt",
      "Dimension": 768
    },
    "Database": {
      "ConnectionString": "REPLACE_WITH_CONNECTION_STRING (optional, enables auto vector search RAG + PDF ingestion)",
      "ActiveTableName": "MemoryFragments"
    },
    "Folders": {
      "AgentFilesFolder": "REPLACE_WITH_PATH_TO_default_workspace_folder (optional, defaults to Documents\\OfflineAI\\AgentFiles)"
    },
    "Gemma4Cli": {
      "LlamaCliPath": "REPLACE_WITH_PATH_TO_llama-cli.exe (optional, falls back to Llm:ExecutablePath)",
      "ModelPath": "REPLACE_WITH_PATH_TO_gemma4_multimodal_model.gguf (optional, enables picture/image queries)"
    }
  }
}
