<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4ad32ab0-0a7e-4a93-be10-20d63b660d7e</UserSecretsId>
    <!-- S5693 is a Security Hotspot ("Limit the content length of HTTP requests") that fires on
         every IBrowserFile.OpenReadStream(maxAllowedSize:) call regardless of the limit's value —
         it has no code fix, only manual review, and neither #pragma nor .editorconfig severity
         overrides suppress it for Razor-generated code. DocumentAnalysis.razor and
         DocumentAnalysisService.cs already pass an explicit, reviewed size cap to every call. -->
    <NoWarn>$(NoWarn);S5693</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI\AI.csproj" />
    <ProjectReference Include="..\Services\Services.csproj" />
    <ProjectReference Include="..\Infrastructure.Data.Dapper\Infrastructure.Data.Dapper.csproj" />
    <ProjectReference Include="..\Types\Types.csproj" />
  </ItemGroup>

  <!-- Auto-publish to a network share after every Release build.
       Opt-in and machine-specific (same philosophy as user secrets): set the
       OFFLINEAI_PUBLISH_DIR environment variable to the target folder, e.g.
       \\SERVER\share\AiDashboard, or pass -p:NetworkPublishDir=... explicitly.
       When the variable is unset the target is skipped entirely, so CI and other
       machines build exactly as before. An unreachable share only warns (the
       build itself still succeeds) — TreatWarningsAsErrors applies to compiler
       warnings, not MSBuild task warnings. Debug builds are never published, so
       the inner dev loop stays fast. -->
  <PropertyGroup>
    <NetworkPublishDir Condition="'$(NetworkPublishDir)' == ''">$(OFFLINEAI_PUBLISH_DIR)</NetworkPublishDir>
  </PropertyGroup>

  <Target Name="PublishToNetworkShare"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(NetworkPublishDir)' != '' And '$(InnerNetworkPublish)' != 'true'">
    <Message Importance="high" Text="→ Publicerar AiDashboard till $(NetworkPublishDir) ..." />
    <!-- InnerNetworkPublish guards against re-entry; the no-build flag reuses the outputs
         the triggering build just produced, so the publish step is copy-only and fast. -->
    <Exec Command='dotnet publish "$(MSBuildProjectFullPath)" -c $(Configuration) --no-build -o "$(NetworkPublishDir)" -p:InnerNetworkPublish=true --nologo'
          ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="→ Publicering klar: $(NetworkPublishDir)" Condition="'$(MSBuildLastTaskResult)' == 'true'" />
  </Target>

</Project>
