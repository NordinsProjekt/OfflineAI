@using Microsoft.AspNetCore.Components.Forms
@using global::AgentKit.Skills.Files
@inject IFileAgentService FileAgent
@inject IJSRuntime JSRuntime

<div class="agent-upload @(DarkMode ? "theme-dark" : "theme-light")">
    <InputFile id="@_inputId"
               @key="_inputId"
               class="agent-upload-input"
               OnChange="HandleFileSelectedAsync"
               accept="@AcceptedTypes"
               disabled="@(Disabled || _isUploading)" />

    <label for="@_inputId"
           class="agent-upload-btn @((Disabled || _isUploading) ? "disabled" : "")"
           title="Attach a file (PDF, text, or image) to the workspace so the AI can read it — or drag and drop one anywhere in the chat">
        @if (_isUploading)
        {
            <span class="agent-upload-spinner"></span>
        }
        else
        {
            <span class="agent-upload-icon">📎</span>
        }
    </label>
</div>

@code {
    /// <summary>Comma-separated accepted file extensions passed to the underlying &lt;input type="file"&gt;.</summary>
    [Parameter] public string AcceptedTypes { get; set; } = ".pdf,.txt,.png,.jpg,.jpeg,.gif,.webp,.bmp";

    /// <summary>
    /// Maximum upload size in bytes. Default: 100 MB. Also requires the SignalR circuit's
    /// <c>MaximumReceiveMessageSize</c> to be raised at least this high (see Program.cs) —
    /// otherwise Blazor Server rejects the transfer before this limit is even checked.
    /// </summary>
    [Parameter] public long MaxFileSizeBytes { get; set; } = 100 * 1024 * 1024;

    /// <summary>Disables the button, e.g. while the chat is already processing a message.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Matches <c>FileDropZone</c>'s dark/light theme convention.</summary>
    [Parameter] public bool DarkMode { get; set; } = true;

    /// <summary>
    /// Optional CSS selector (e.g. <c>".oa-chat"</c> or <c>".oa-quick-card"</c>) for a larger
    /// container that should also accept drag-and-dropped files, in addition to this component's
    /// own attach button — dropped files are fed through the exact same upload path. Null (the
    /// default) disables drag-and-drop; only the button remains clickable.
    /// </summary>
    [Parameter] public string? DropZoneSelector { get; set; }

    /// <summary>Raised with the saved bare filename after a successful upload.</summary>
    [Parameter] public EventCallback<string> OnUploaded { get; set; }

    /// <summary>Raised with a human-readable message when validation or saving fails.</summary>
    [Parameter] public EventCallback<string> OnError { get; set; }

    private string _inputId = $"agent-upload-{Guid.NewGuid():N}";
    private bool _isUploading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrWhiteSpace(DropZoneSelector))
            return;

        try
        {
            // Idempotent on the JS side (safe to call every render): (re)points the drop zone at
            // this render's _inputId, since ResetInput() gives the <InputFile> a new id after
            // every upload, but only attaches the actual drag/drop listeners once per element.
            await JSRuntime.InvokeVoidAsync("fileDropZone.initializePersistent", DropZoneSelector, _inputId, Disabled || _isUploading);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"AgentFileUpload: Failed to initialize drop zone JavaScript: {ex.Message}");
        }
    }

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        var acceptedExtensions = AcceptedTypes.Split(',').Select(t => t.Trim().ToLowerInvariant()).ToList();
        if (!acceptedExtensions.Contains(extension))
        {
            // The browser only enforces the `accept` attribute for the file-picker dialog, not
            // for drag-and-drop — so a dropped file needs this check too.
            await OnError.InvokeAsync($"Filtypen \"{extension}\" stöds inte. Tillåtna typer: {AcceptedTypes}");
            ResetInput();
            return;
        }

        if (file.Size > MaxFileSizeBytes)
        {
            await OnError.InvokeAsync(
                $"Filen \"{file.Name}\" ({FormatSize(file.Size)}) är för stor. Max: {FormatSize(MaxFileSizeBytes)}.");
            ResetInput();
            return;
        }

        _isUploading = true;
        StateHasChanged();

        try
        {
            await using var stream = file.OpenReadStream(MaxFileSizeBytes);
            var result = await FileAgent.SaveUploadedFileAsync(file.Name, stream);

            if (result.IsSuccess)
                await OnUploaded.InvokeAsync(file.Name);
            else
                await OnError.InvokeAsync(result.Message);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Kunde inte ladda upp \"{file.Name}\": {ex.Message}");
        }
        finally
        {
            _isUploading = false;
            ResetInput();
            StateHasChanged();
        }
    }

    private void ResetInput()
    {
        // Recreate the <InputFile> element (via @key) so selecting the same file again still
        // triggers OnChange — Blazor otherwise treats an unchanged <input> value as a no-op.
        _inputId = $"agent-upload-{Guid.NewGuid():N}";
    }

    private static string FormatSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        double len = bytes;
        var order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
