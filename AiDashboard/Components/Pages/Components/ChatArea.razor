@inject DashboardState Dashboard

<main class="oa-chat">
    <!-- Expand button when collapsed -->
    @if (Dashboard.Collapsed)
    {
        <button type="button" class="oa-expand" title="Expand" aria-label="Expand sidebar" @onclick="Dashboard.ToggleSidebar">&lt;</button>
    }

    <ChatTopBar />
    <ChatMessages Messages="@Messages" IsProcessing="@IsProcessing" />
    <ChatComposer ComposerText="@ComposerText"
                  IsProcessing="@IsProcessing"
                  OnComposerTextChanged="@OnComposerTextChanged"
                  OnKeyDown="@OnKeyDown"
                  OnSendMessage="@OnSendMessage"
                  OnFileUploaded="@OnFileUploaded"
                  OnFileUploadError="@OnFileUploadError" />
</main>

@code {
    [Parameter]
    public List<ChatMessageModel> Messages { get; set; } = new();

    [Parameter]
    public bool IsProcessing { get; set; }

    [Parameter]
    public string ComposerText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnComposerTextChanged { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter]
    public EventCallback OnSendMessage { get; set; }

    [Parameter]
    public EventCallback<string> OnFileUploaded { get; set; }

    [Parameter]
    public EventCallback<string> OnFileUploadError { get; set; }
}
